{
    "name": "vibono/vibono-app-api",
    "description": "WordPress-Plugin: REST-Schnittstelle für die Vibono-App und zentrales Punktesystem",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "anthropic-ai/sdk": "^1.8",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": { "Vibono\\AppApi\\": "includes/" }
    },
    "config": {
        "allow-plugins": { "php-http/discovery": true },
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit -c tests/phpunit.xml"
    }
}
